<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ⚠️ 权限策略（2026-10 安全整改，见 README「关于安全扫描」）

      这里刻意只保留「解析和保存」真正需要的最小权限集。
      每多一个权限、尤其是「安装应用」「读写全盘」「读取应用列表」这类，
      都会抬高国产安全引擎（腾讯/安天病毒库，小米/OPPO/vivo/华为都在用）
      的评分，最终被标成 a.gray.* 灰色软件。

      历史包袱说明：
        v0.0.5 及以前声明过 REQUEST_INSTALL_PACKAGES（应用内下载 APK 后
        拉起系统安装器）。这个组合——「联网下载可执行文件 + 请求安装」——
        在静态扫描里和推广/捆绑类恶意软件无法区分，是当初被判高危的
        最大单一原因。v0.0.6 起**彻底移除**：更新改为打开浏览器下载页，
        由系统下载器和系统安装流程接管。
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      保存到相册：
      Android 10（API 29）及以上走 MediaStore，**不需要任何存储权限**。
      这里只为 Android 9 及以下保留写入权限，所以加了 maxSdkVersion 限制 ——
      新系统上不会向用户索要一个根本用不到的敏感权限。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <application
        android:label="小鲸鱼"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          usesCleartextTraffic=false + network_security_config 全量禁止明文：
          小鲸鱼访问的平台接口、CDN、更新清单全部是 HTTPS，没有任何理由
          保留 HTTP 回退。开着明文除了安全风险，也会被扫描器记为可疑项。
          allowBackup=false：解析历史只留在本机，不参与云备份。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin.
         这是 Flutter 引擎自带的、范围最小的一条可见性声明。除此之外不再
         声明任何 <queries>，也不申请 QUERY_ALL_PACKAGES —— 小鲸鱼不需要
         知道用户装了哪些 App。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
