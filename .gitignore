#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---- 小鲸鱼项目追加 ----

# 构建产物不进仓库：一个 APK 就 20MB，放 Releases 或自己的服务器
*.apk
*.aab
/dist/

# Android 构建缓存与本地配置
android/.gradle/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
.cxx/

# 给 pubspec 加了 assets 之后，增量构建偶尔会在这里撞名（errno 183），
# 清掉即可重来。它是临时产物，不该进版本库。
build/app/intermediates/flutter/

# 临时/测试产物
tmp/
Thumbs.db

# 本地构建配置：里面是真实服务器地址，不能进公开仓库
tools/build.config.ps1